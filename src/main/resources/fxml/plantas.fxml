<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      spacing="16.0"
      stylesheets="@../css/main.css"
      styleClass="pantalla-riego">
    <padding>
        <Insets top="24.0" right="28.0" bottom="24.0" left="28.0" />
    </padding>
    <Label text="Plantas y umbrales" styleClass="titulo-pantalla" />
    <Label text="Añade plantas y configura la humedad mínima (%) que activa el aviso." />
    <HBox spacing="10.0">
        <ListView fx:id="listaPlantas" prefWidth="290.0" prefHeight="300.0" />
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <Label text="Nombre" />
            <TextField fx:id="campoNombre" promptText="Nombre de la planta" />
            <Label text="Humedad mínima (%)" />
            <TextField fx:id="campoUmbral" promptText="Por ejemplo: 30" />
            <Button text="Nueva planta" onAction="#nuevaPlanta" />
            <Button text="Añadir planta" onAction="#crearPlanta" />
            <Button text="Guardar cambios" onAction="#guardarCambios" />
            <Label fx:id="etiquetaMensaje" wrapText="true" />
        </VBox>
    </HBox>
</VBox>
